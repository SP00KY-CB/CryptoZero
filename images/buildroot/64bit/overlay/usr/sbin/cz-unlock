#!/bin/sh
# Pre-boot authentication: TPM secret (+PIN) + CIK on microSD -> Opal unlock.
# Falls back to the stock passphrase prompt if either factor is unavailable.
. /usr/lib/cryptozero/cz-lib.sh

fallback() {
    echo "$1"
    echo "Falling back to manual passphrase."
    exec /sbin/linuxpba 2>/tmp/pbaerror.log
}

echo "CryptoZero boot authorization"

# TPM present but nothing sealed yet (or TPM was cleared): enrollment mode.
# The shell grants nothing on an enrolled machine: the drive stays locked
# until the Opal password is supplied.
if { [ -e /dev/tpm0 ] || [ -e /dev/tpmrm0 ]; } && ! tpm2_readpublic -c "$CZ_TPM_HANDLE" >/dev/null 2>&1; then
    echo
    echo "No sealed secret found in the TPM: enrollment mode."
    echo "  cz-enroll <opal-dev> <cik-partition> --pba <boot-usb-dev> --escrow FILE"
    echo "  linuxpba      (enter the Opal passphrase manually, e.g. after a TPM clear)"
    exec /bin/sh -l
fi

CIKDEV=$(cz_find_cik_dev) || fallback "CIK microSD not found."
CIK=$(cz_read_cik "$CIKDEV") || fallback "CIK not valid on $CIKDEV."

PIN=""
if [ "$CZ_USE_PIN" = 1 ]; then
    printf 'PIN: '; stty -echo; read -r PIN; stty echo; echo
fi

TPMSEC=$(cz_unseal "$PIN") || fallback "TPM refused to release secret (PCR mismatch, wrong PIN, or lockout)."
PIN=""

KEY=$(cz_derive "$TPMSEC" "$CIK")
TPMSEC=""; CIK=""

if printf '%s\n' "$KEY" | /sbin/linuxpba --key-stdin; then
    KEY=""
    echo "Access granted. Starting the system..."
    sync
    reboot -f
fi
KEY=""
fallback "Unlock failed."
